# Copy this file to ".env" and fill in real values.
# Never commit the real .env file.

# Long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Which config class to use: development | production
APP_ENV=development

# Leave empty to use instance/erdenet_ajil.sqlite3
DATABASE_URL=

# The office phone shown on the public job board (8 digits, optional +976).
# Job seekers tap "Оффис руу залгах" to call it. Use the office's real number.
OFFICE_PHONE= 99129558
